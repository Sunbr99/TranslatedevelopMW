{
  "name": "mw-translate",
  "version": "2.1.0",
  "description": "MW Translate - Free translation PWA (Google + MyMemory, no API key)",
  "main": "index.html",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "echo 'PWA v2 ready for deployment'",
    "setup": "npm install",
    "cap:init": "npx cap init 'MW Translate' com.mwtranslate.app --web-dir .",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "install-capacitor": "npm install @capacitor/cli @capacitor/core @capacitor/android",
    "capacitor-sync": "npx cap sync android",
    "build-apk": "npm run capacitor-sync && cd android && ./gradlew assembleDebug",
    "apk:debug": "npx cap sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npx cap sync && cd android && ./gradlew assembleRelease",
    "apk:find": "find android/app/build/outputs/apk -name '*.apk' 2>/dev/null"
  },
  "keywords": [
    "translate",
    "translation",
    "code",
    "analysis",
    "PWA",
    "offline",
    "AI"
  ],
  "author": "MW Translate",
  "license": "MIT",
  "dependencies": {
    "@capacitor/core": "^5.7.0",
    "@capacitor/android": "^5.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
